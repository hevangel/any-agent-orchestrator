            ],
            "headless_verified": true,
            "herdr_kind": null,
            "account": {
                "type": "env",
                "var": "XDG_DATA_HOME",
                "default": "~/.local/share",
                "verified": false,
                "note": "parent of the kilo/ data directory"
            },
            "permission": {
                "auto": [
                    "--auto"
                ],
                "yolo": [
                    "--auto"
                ]
