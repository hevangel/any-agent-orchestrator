# =============================================================================
# any-agent-orchestrator - environment configuration
# Copy to .env and fill in what you need. Never commit .env.
# =============================================================================

# ---- Docker ------------------------------------------------------------------
# Agents to bake into the image (empty = all). Tags: core, tier2, byok, free-tokens
AGENT_TAGS=
# Host home directory whose agent credential folders are mounted (default: $HOME, then %USERPROFILE%)
# HOST_HOME=C:/Users/you
# Workspace mounted at /workspace (default: this checkout)
# WORKSPACE=../my-main-repo

# Token logins for agents whose host credentials live in the macOS Keychain or for CI
# CLAUDE_CODE_OAUTH_TOKEN=    # from `claude setup-token`
# GH_TOKEN=                   # needs repo + project scopes for GitHub Project orchestration
# OPENAI_API_KEY=

# ---- Cloud agents and dashboard ------------------------------------------------
# Cursor cloud agents API (Cursor dashboard > Integrations); without it the Cursor card shows "unavailable"
# CURSOR_API_KEY=
# Where collector snapshots go (default: ./state)
# AAO_STATE_DIR=
# Name shown for this computer on the Machines tab (default: hostname)
# AAO_LOCAL_LABEL=
# Agents whose built-in quota screens fill gaps left by external collectors.
# Default: every installed agent with quota_screen in agents.json (claude,codex,cursor,kiro,antigravity).
# Set to none to disable interactive quota reads.
# AAO_QUOTA_SCREEN_AGENTS=claude,codex,cursor,kiro,antigravity

# ---- GitHub Project orchestration layer ---------------------------------------
# GITHUB_PROJECT_OWNER=your-user-or-org
# GITHUB_PROJECT_NUMBER=1

# ---- Agent mailbox -------------------------------------------------------------
# dropbox or box
# MAILBOX_BACKEND=dropbox
# Root folder of the mailbox in that storage
# MAILBOX_ROOT=/agents_mailbox

# ---- Web interfaces ------------------------------------------------------------
# Chrome DevTools endpoint for attaching to an already-logged-in browser (playwright-cli / browser-harness)
# BROWSER_CDP_URL=http://127.0.0.1:9222
# Saved login profiles, one per site (`uv run aao web login <site>`); keep outside the repo
AAO_WEB_PROFILE_DIR=~/.aao/browser-profiles
# Browser for playwright-cli: empty = bundled Chromium; `chrome` = installed Chrome (needed for Google sign-in)
AAO_WEB_BROWSER=chrome
# 1 = visible window (fewer bot checks), 0 = headless
AAO_WEB_HEADED=1

# ---- Agent permissions -------------------------------------------------------------
# auto = each CLI's automatic-approval mode (claude --permission-mode auto, codex --approve-for-me,
#        cursor --auto-review, copilot --allow-all-tools, ...)
# yolo = skip every permission check (--dangerously-skip-permissions, --yolo, ...); sandboxes only
AAO_PERMISSION_MODE=auto
# 1 = answer the agent's "trust this folder?" screen automatically (scripted keys from agents.json)
AAO_TRUST_FOLDERS=1

# ---- Machines --------------------------------------------------------------------
# CLIs installed on this computer (default: every agents.json CLI found on PATH)
# AAO_LOCAL_CLIS=claude,codex,cursor,copilot,opencode

# Remote machines. Per host: SSH target (default: the label), herdr machine label
# (empty = not saved in herdr), OS, and the CLIs installed there.
AAO_HOSTS=devbox
AAO_HOST_devbox_SSH=user@devbox.local
AAO_HOST_devbox_HERDR=devbox
AAO_HOST_devbox_OS=linux
AAO_HOST_devbox_CLIS=claude,codex

# ---- Subscriptions and accounts ------------------------------------------------------
# Any number of accounts per CLI, free and paid mixed. The orchestrator uses free accounts
# first, then paid by PRIORITY (lower first), then API-billed, and skips an account whose
# tightest quota window is below 10% (see `uv run aao accounts --agent claude`).
#
#   AGENT        agents.json id (claude, codex, cursor, copilot, opencode, kilo, hermes, zcode, ...)
#   PLAN         your plan name, free text (pro, max-20x, plus, team, free, ...)
#   TIER         paid | free | api
#   HOME         where this account's login lives: CLAUDE_CONFIG_DIR for claude, CODEX_HOME for codex,
#                XDG_DATA_HOME for opencode/kilo, a profile name for hermes. Empty = the CLI's default login.
#                Log a new account in once with that variable set, e.g.
#                  CLAUDE_CONFIG_DIR=~/.claude-work claude      then /login
#   SECRET_ENV   for API-key accounts (cursor, zcode): the NAME of the variable that holds the key
#   HOSTS        machines this login exists on (local and/or AAO_HOSTS labels)
#   PRIORITY     lower is used first within a tier
#   MONTHLY_USD  what the plan costs, to compare with the dashboard's API-equivalent cost
AAO_ACCOUNTS=claude_personal,claude_work,codex_plus,zai_free

AAO_ACCOUNT_claude_personal_AGENT=claude
AAO_ACCOUNT_claude_personal_PLAN=max-5x
AAO_ACCOUNT_claude_personal_TIER=paid
AAO_ACCOUNT_claude_personal_HOSTS=local,devbox
AAO_ACCOUNT_claude_personal_PRIORITY=1
AAO_ACCOUNT_claude_personal_MONTHLY_USD=100

AAO_ACCOUNT_claude_work_AGENT=claude
AAO_ACCOUNT_claude_work_PLAN=team
AAO_ACCOUNT_claude_work_TIER=paid
AAO_ACCOUNT_claude_work_HOME=~/.claude-work
AAO_ACCOUNT_claude_work_HOSTS=local
AAO_ACCOUNT_claude_work_PRIORITY=2

AAO_ACCOUNT_codex_plus_AGENT=codex
AAO_ACCOUNT_codex_plus_PLAN=plus
AAO_ACCOUNT_codex_plus_TIER=paid
AAO_ACCOUNT_codex_plus_HOSTS=local,devbox
AAO_ACCOUNT_codex_plus_MONTHLY_USD=20

AAO_ACCOUNT_zai_free_AGENT=zcode
AAO_ACCOUNT_zai_free_PLAN=free
AAO_ACCOUNT_zai_free_TIER=free
AAO_ACCOUNT_zai_free_SECRET_ENV=ZAI_FREE_API_KEY
# ZAI_FREE_API_KEY=

# ---- End-to-end tests (uv run pytest -m e2e) -------------------------------------------
# Run modes: native, docker, herdr, herdr-agent (interactive TUI via herdr's agent API), ssh, herdr-remote
AAO_E2E_MODES=native,docker,herdr,ssh,herdr-remote
# CLIs to test (each case spends a few hundred tokens); a CLI not installed on a machine is skipped there
AAO_E2E_CLIS=claude,codex,cursor,copilot,kiro,antigravity,zcode,hermes,kilo,opencode,muse
# Model per CLI for tests ([provider:]model, via agents.json model_args); a free model keeps tests from spending credits
AAO_E2E_MODEL_hermes=openrouter:nvidia/nemotron-3-nano-omni-30b-a3b-reasoning:free
# all = one case per configured account; default = only each CLI's default login
AAO_E2E_ACCOUNTS=all
# Web apps to test: chatgpt, claude, gemini, grok, muse, zai, codex-cloud, claude-code-web
AAO_E2E_WEB=chatgpt,claude,gemini,grok,muse,zai,codex-cloud,claude-code-web
# Seconds per case
AAO_E2E_TIMEOUT=180
# Folder the herdr-agent mode starts interactive agents in (default: a fresh temp folder per case)
# AAO_E2E_AGENT_CWD=~/aao-e2e
