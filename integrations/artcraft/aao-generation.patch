@@ -0,0 +1,500 @@
+import { useEffect, useRef, useState, type ReactNode } from "react";
+import { PopoverMenu } from "@storyteller/ui-popover";
+import { RatioIcon } from "lucide-react";
+import { isTauri } from "@tauri-apps/api/core";
+import { fetch as desktopFetch } from "@tauri-apps/plugin-http";
+import { KeyframeCards, ReferenceDeck, type DeckItem } from "@storyteller/ui-promptbox";
+import { GalleryModal } from "@storyteller/ui-gallery-modal";
+import { downloadMediaFileToDisk } from "./desktopMediaActions";
+import {
+  AAO_IMPORT_CHANGED,
+  enqueueAaoMedia,
+  getAaoLibraryImport,
+  getArtCraftLibraryOwner,
+  getArtCraftMediaUrl,
+  MediaHttpError,
+  queueAaoLibraryImport,
+  requestAaoMedia as request,
+  useAaoImportedMediaTokens,
+  type AaoImageRatio,
+  type AaoMediaJob,
+  type AaoMediaKind,
+} from "./aaoLibraryImports";
+
+interface Provider {
+  id: string;
+  label: string;
+  kind: AaoMediaKind;
+  available: boolean;
+  detail: string;
+  image_reference_limit?: number;
+}
+
+const IMAGE_RATIOS: AaoImageRatio[] = ["1:1", "16:9", "9:16", "4:3", "3:4"];
+const REFERENCE_TYPES = ["image/png", "image/jpeg", "image/webp"];
+const MAX_REFERENCE_BYTES = 8 * 1024 * 1024;
+
+interface MediaReference {
+  id: string;
+  url: string;
+  thumbnail?: string;
+}
+
+async function encodeReference(file: Blob): Promise<string> {
+  if (!REFERENCE_TYPES.includes(file.type) || file.size > MAX_REFERENCE_BYTES) {
+    throw new Error("Choose a PNG, JPEG, or WebP image up to 8 MiB.");
+  }
+  return new Promise((resolve, reject) => {
+    const reader = new FileReader();
+    reader.onload = () => resolve(reader.result as string);
+    reader.onerror = () => reject(new Error("Could not read the reference image."));
+    reader.readAsDataURL(file);
+  });
+}
+
+async function readReference({ url }: MediaReference) {
+  if (url.startsWith("data:")) return url;
+  const fetchImage = isTauri() && /^https?:/i.test(url) ? desktopFetch : fetch;
+  const response = await fetchImage(url);
+  if (!response.ok) throw new Error("Could not load the reference image from My Library.");
+  const file = await response.blob();
+  if (REFERENCE_TYPES.includes(file.type) && file.size <= MAX_REFERENCE_BYTES) {
+    return encodeReference(file);
+  }
+  // Library images can come from providers that store other image formats.
+  const image = await createImageBitmap(file).catch(() => {
+    throw new Error("Could not decode the reference image from My Library.");
+  });
+  try {
+    const scale = Math.min(1, 2048 / Math.max(image.width, image.height));
+    const canvas = document.createElement("canvas");
+    canvas.width = Math.max(1, Math.round(image.width * scale));
+    canvas.height = Math.max(1, Math.round(image.height * scale));
+    const context = canvas.getContext("2d");
+    if (!context) throw new Error("Could not prepare the reference image.");
+    context.drawImage(image, 0, 0, canvas.width, canvas.height);
+    const prepared = await new Promise<Blob>((resolve, reject) => {
+      canvas.toBlob((blob) => blob ? resolve(blob)
+        : reject(new Error("Could not prepare the reference image.")), "image/webp", 0.92);
+    });
+    return encodeReference(prepared);
+  } finally {
+    image.close();
+  }
+}
+
+function MediaReferencePicker({
+  references,
+  onChange,
+  onError,
+  reading,
+  setReading,
+  limit,
+  firstFrame,
+  kind,
+}: {
+  references: MediaReference[];
+  onChange: (references: MediaReference[]) => void;
+  onError: (message?: string) => void;
+  reading: boolean;
+  setReading: (reading: boolean) => void;
+  limit: number;
+  firstFrame: boolean;
+  kind: AaoMediaKind;
+}) {
+  const fileInput = useRef<HTMLInputElement>(null);
+  const [selection, setSelection] = useState<string[]>();
+  const generatedUploadTokens = useAaoImportedMediaTokens();
+  const remaining = limit - references.length;
+  const items: DeckItem[] = references.map((reference, index) => ({
+    id: reference.id,
+    kind: "image",
+    name: firstFrame ? "First frame" : `Image ${index + 1}`,
+    url: reference.thumbnail ?? reference.url,
+    previewUrl: reference.url,
+  }));
+  const addActions = [
+    { key: "upload", label: "Upload", onSelect: () => fileInput.current?.click() },
+    { key: "library", label: "Pick from library", onSelect: () => setSelection([]) },
+  ];
+  const addFiles = async (files: File[]) => {
+    setReading(true);
+    onError();
+    try {
+      const added = await Promise.all(files.map(async (file) => ({
+        id: crypto.randomUUID(),
+        url: await encodeReference(file),
+      })));
+      onChange([...references, ...added]);
+    } catch (error) {
+      onError(String(error));
+    } finally {
+      setReading(false);
+    }
+  };
+  return (
+    <>
+      <input
+        ref={fileInput}
+        type="file"
+        aria-label={`Upload ${kind === "audio" ? "soundtrack" : kind} reference images`}
+        hidden
+        multiple={remaining > 1}
+        accept={REFERENCE_TYPES.join(",")}
+        onChange={(event) => {
+          const files = Array.from(event.target.files ?? []).slice(0, remaining);
+          event.target.value = "";
+          if (files.length) void addFiles(files);
+        }}
+      />
+      {reading ? (
+        <span role="status" className="text-sm">Reading images…</span>
+      ) : firstFrame ? (
+        <KeyframeCards
+          firstFrame={items[0]}
+          showLastFrame={false}
+          onFirstAddActions={addActions}
+          onRemoveFirst={() => onChange([])}
+        />
+      ) : (
+        <ReferenceDeck
+          items={items}
+          canAdd={remaining > 0}
+          addActions={addActions}
+          onRemove={(id) => onChange(references.filter((reference) => reference.id !== id))}
+          onClearAll={() => onChange([])}
+        />
+      )}
+      {selection && (
+        <GalleryModal
+          isOpen
+          mode="select"
+          forceFilter="image"
+          generatedUploadTokens={generatedUploadTokens}
+          maxSelections={remaining}
+          disabledItemIds={references.map(({ id }) => id)}
+          selectedItemIds={selection}
+          onClose={() => setSelection(undefined)}
+          onSelectItem={(id) => setSelection((selected = []) =>
+            selected.includes(id) ? selected.filter((item) => item !== id)
+              : remaining === 1 ? [id] : [...selected, id].slice(0, remaining),
+          )}
+          onUseSelected={(selected) => {
+            const chosen = selected.flatMap(({ id, fullImage, thumbnail }) =>
+              fullImage ? [{ id, url: fullImage, thumbnail: thumbnail ?? undefined }] : [],
+            );
+            if (!chosen.length) {
+              onError("The selected images are unavailable.");
+              return;
+            }
+            onError();
+            onChange([...references, ...chosen.slice(0, remaining)]);
+            setSelection(undefined);
+          }}
+        />
+      )}
+    </>
+  );
+}
+
+export function AaoAspectRatio({
+  ratio,
+  onChange,
+}: {
+  ratio?: AaoImageRatio;
+  onChange: (ratio?: AaoImageRatio) => void;
+}) {
+  return (
+    <PopoverMenu
+      items={[
+        { label: "Auto", selected: ratio === undefined },
+        ...IMAGE_RATIOS.map((value) => ({
+          label: value,
+          selected: ratio === value,
+        })),
+      ]}
+      onSelect={({ label }) =>
+        onChange(IMAGE_RATIOS.find((value) => value === label))
+      }
+      mode="toggle"
+      panelTitle="Aspect Ratio"
+      triggerIcon={<RatioIcon aria-label="Aspect ratio" className="h-4 w-4" />}
+    />
+  );
+}
+
+export function useAaoGeneration(kind: AaoMediaKind) {
+  const [providers, setProviders] = useState<Provider[] | undefined>();
+  const [selected, setSelected] = useState<string>();
+  const [online, setOnline] = useState(false);
+
+  useEffect(() => {
+    const controller = new AbortController();
+    const refresh = async () => {
+      try {
+        const response = await request("/providers", {
+          signal: controller.signal,
+        });
+        const catalog: Provider[] = await response.json();
+        setProviders(catalog.filter((provider) => provider.kind === kind));
+        setOnline(true);
+      } catch {
+        if (!controller.signal.aborted) setOnline(false);
+      }
+    };
+    void refresh();
+    const interval = setInterval(refresh, 10000);
+    return () => {
+      controller.abort();
+      clearInterval(interval);
+    };
+  }, [kind]);
+
+  return {
+    provider: providers?.find(
+      (provider) => provider.id === selected && provider.available,
+    ),
+    online,
+    items: providers?.map((provider) => ({
+      action: `aao:${provider.id}`,
+      label: provider.label,
+      description: online ? provider.detail : "AAO media service is offline",
+      selected: provider.id === selected && provider.available,
+      disabled: !online || !provider.available,
+    })) ?? [
+      {
+        label: "AAO providers",
+        description: "Start AAO locally with aao media-serve",
+        selected: false,
+        disabled: true,
+      },
+    ],
+    onSelect: ({ action }: { action?: string }) => {
+      setSelected(action?.startsWith("aao:") ? action.slice(4) : undefined);
+    },
+  };
+}
+
+export function AaoGeneration({
+  provider,
+  selector,
+  online,
+  initialVideoReference,
+}: {
+  provider: Provider;
+  selector: ReactNode;
+  online: boolean;
+  initialVideoReference?: MediaReference;
+}) {
+  const subject = provider.kind === "audio" ? "music" : provider.kind;
+  const storageKey = `aao-media-job:${provider.kind}:${provider.id}`;
+  const [prompt, setPrompt] = useState("");
+  const [ratio, setRatio] = useState<AaoImageRatio>();
+  const referenceLimit = provider.image_reference_limit ?? (provider.kind === "image" ? 4 : 0);
+  const [references, setReferences] = useState<MediaReference[]>(
+    () => referenceLimit && initialVideoReference ? [initialVideoReference] : [],
+  );
+  const [referenceError, setReferenceError] = useState<string>();
+  const [readingReferences, setReadingReferences] = useState(false);
+  const [jobId, setJobId] = useState<string | undefined>(
+    () => localStorage.getItem(storageKey) ?? undefined,
+  );
+  const [job, setJob] = useState<AaoMediaJob>();
+  const [busy, setBusy] = useState(false);
+  const [libraryImport, setLibraryImport] = useState(() =>
+    getAaoLibraryImport(jobId),
+  );
+  const [error, setError] = useState<string>();
+
+  useEffect(() => {
+    const updateImport = () => setLibraryImport(getAaoLibraryImport(jobId));
+    window.addEventListener(AAO_IMPORT_CHANGED, updateImport);
+    updateImport();
+    return () => window.removeEventListener(AAO_IMPORT_CHANGED, updateImport);
+  }, [jobId]);
+
+  useEffect(() => {
+    if (!jobId) return;
+    const controller = new AbortController();
+    let timer: ReturnType<typeof setTimeout>;
+    const poll = async () => {
+      try {
+        const response = await request(`/jobs/${jobId}`, {
+          signal: controller.signal,
+        });
+        const update: AaoMediaJob = await response.json();
+        if (controller.signal.aborted) return;
+        setJob(update);
+        setError(undefined);
+        if (update.state === "pending") timer = setTimeout(poll, 1200);
+      } catch (err) {
+        if (!controller.signal.aborted) {
+          setError(String(err));
+          if (err instanceof MediaHttpError && err.status === 404) {
+            setJob(undefined);
+            setJobId(undefined);
+            localStorage.removeItem(storageKey);
+          } else {
+            timer = setTimeout(poll, 3000);
+          }
+        }
+      }
+    };
+    void poll();
+    return () => {
+      controller.abort();
+      clearTimeout(timer);
+    };
+  }, [jobId, storageKey]);
+
+  const generate = async () => {
+    setBusy(true);
+    setError(undefined);
+    try {
+      const id = await enqueueAaoMedia(provider.id, provider.kind, prompt, {
+        aspect_ratio: ratio,
+        references: references.length
+          ? await Promise.all(references.map(readReference))
+          : undefined,
+      });
+      localStorage.setItem(storageKey, id);
+      setJob({ state: "pending", files: [] });
+      setJobId(id);
+    } catch (err) {
+      setError(String(err));
+    } finally {
+      setBusy(false);
+    }
+  };
+
+  const download = async (name: string, index: number) => {
+    try {
+      const token = libraryImport?.files[index]?.token;
+      if (token) {
+        const url = await getArtCraftMediaUrl(token);
+        if (url) {
+          await downloadMediaFileToDisk(url, provider.kind, provider.id);
+          return;
+        }
+      }
+      const response = await request(`/jobs/${jobId}/files/${index}`);
+      const url = URL.createObjectURL(await response.blob());
+      const link = document.createElement("a");
+      link.href = url;
+      link.download = name;
+      link.click();
+      setTimeout(() => URL.revokeObjectURL(url), 30000);
+    } catch (err) {
+      setError(String(err));
+    }
+  };
+
+  const retryImport = async () => {
+    if (!jobId) return;
+    setError(undefined);
+    try {
+      const owner = await getArtCraftLibraryOwner();
+      if (!owner)
+        throw new Error("Sign in to ArtCraft to import into My Library.");
+      queueAaoLibraryImport(jobId, provider.kind, provider.id, owner);
+    } catch (err) {
+      setError(String(err));
+    }
+  };
+
+  const pending = Boolean(jobId && (!job || job.state === "pending"));
+  const savedToLibrary =
+    job?.state === "succeeded" &&
+    job.files.every((_, index) => !!libraryImport?.files[index]?.token);
+  return (
+    <div className="glass rounded-lg border border-ui-controls-border bg-ui-background p-4">
+      <div className="flex items-start gap-3">
+        {referenceLimit > 0 && (
+          <MediaReferencePicker
+            references={references}
+            onChange={setReferences}
+            onError={setReferenceError}
+            reading={readingReferences}
+            setReading={setReadingReferences}
+            limit={referenceLimit}
+            firstFrame={provider.kind === "video" && provider.id === "grok"}
+            kind={provider.kind}
+          />
+        )}
+        <textarea
+          aria-label={`Describe the ${subject} to generate with AAO`}
+          placeholder={`Describe the ${subject} to generate…`}
+          className="mb-3 w-full resize-y bg-transparent"
+          value={prompt}
+          onChange={(event) => setPrompt(event.target.value)}
+          maxLength={10000}
+          rows={3}
+        />
+      </div>
+      <div className="flex items-center justify-between gap-3">
+        <div className="flex flex-wrap items-center gap-2">
+          {selector}
+          {provider.kind === "image" && (
+            <AaoAspectRatio ratio={ratio} onChange={setRatio} />
+          )}
+        </div>
+        <button
+          type="button"
+          onClick={() => void generate()}
+          disabled={!online || busy || pending || readingReferences || !prompt.trim()}
+          className="rounded bg-primary px-4 py-2 text-white disabled:opacity-40"
+        >
+          {pending ? "Generating…" : `Generate ${subject}`}
+        </button>
+      </div>
+      {!online && (
+        <p role="status" className="mt-2 text-sm">
+          AAO media service is offline.
+        </p>
+      )}
+      {referenceError && <p role="alert" className="mt-2 text-sm">{referenceError}</p>}
+      {(error || job?.error) && (
+        <p role="alert" className="mt-2 text-sm">
+          {error || job?.error}
+        </p>
+      )}
+      {job?.state === "succeeded" && (
+        <div
+          className="mt-2 flex flex-wrap gap-3 text-sm"
+          aria-label="AAO results"
+        >
+          {job.files.map((name, index) => (
+            <button
+              key={index}
+              type="button"
+              className="underline"
+              onClick={() => void download(name, index)}
+            >
+              Download {name}
+            </button>
+          ))}
+          {savedToLibrary && <span role="status">Saved to My Library</span>}
+          {libraryImport && !libraryImport.error && !savedToLibrary && (
+            <span role="status">Saving to My Library…</span>
+          )}
+          {(!libraryImport || libraryImport.error) && (
+            <button
+              type="button"
+              className="underline"
+              onClick={() => void retryImport()}
+            >
+              {savedToLibrary
+                ? "Retry auto-download"
+                : libraryImport?.error
+                  ? "Retry library import"
+                  : "Import to My Library"}
+            </button>
+          )}
+          {libraryImport?.error && (
+            <span role="alert">{libraryImport.error}</span>
+          )}
+        </div>
+      )}
+    </div>
+  );
+}
