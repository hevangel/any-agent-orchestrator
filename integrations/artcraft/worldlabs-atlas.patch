+import { useEffect, useState } from "react";
+import { invoke } from "@tauri-apps/api/core";
+import { open, save } from "@tauri-apps/plugin-dialog";
+
+type Run =
+  | { stage: "submit"; assets: string[]; requestId: string; prompt: string }
+  | { stage: "pose"; operationId: string; prompt: string }
+  | { stage: "splat"; operationId: string }
+  | { stage: "ready"; asset: string };
+
+const STORAGE_KEY = "artcraft.atlas.run";
+const MAX_IMAGES = 32;
+
+function readRun(): Run | undefined {
+  try {
+    return JSON.parse(localStorage.getItem(STORAGE_KEY) ?? "null") ?? undefined;
+  } catch {
+    return undefined;
+  }
+}
+
+async function advance(run: Exclude<Run, { stage: "ready" }>): Promise<Run> {
+  if (run.stage === "submit") {
+    const operationId = await invoke<string>("atlas_start", {
+      assets: run.assets, requestId: run.requestId,
+    });
+    return { stage: "pose", operationId, prompt: run.prompt };
+  }
+  const status = await invoke<{ done: boolean; assetId?: string }>(
+    "atlas_status", { operationId: run.operationId },
+  );
+  if (!status.done) return run;
+  if (run.stage === "pose") {
+    const operationId = await invoke<string>("atlas_reconstruct", {
+      poseId: run.operationId, prompt: run.prompt,
+    });
+    return { stage: "splat", operationId };
+  }
+  if (!status.assetId) throw new Error("Atlas finished without an SPZ asset.");
+  return { stage: "ready", asset: status.assetId };
+}
+
+export function AtlasWorld() {
+  const [photos, setPhotos] = useState<string[]>([]);
+  const [prompt, setPrompt] = useState("");
+  const [run, setRun] = useState(readRun);
+  const [busy, setBusy] = useState(false);
+  const [error, setError] = useState<string>();
+  const [saved, setSaved] = useState<string>();
+  const active = run && run.stage !== "ready";
+
+  const updateRun = (next: Run) => {
+    localStorage.setItem(STORAGE_KEY, JSON.stringify(next));
+    setRun(next);
+  };
+
+  useEffect(() => {
+    if (!run || run.stage === "ready" || error) return;
+    let disposed = false;
+    let timer: ReturnType<typeof setTimeout>;
+    async function poll(current: Exclude<Run, { stage: "ready" }>) {
+      try {
+        const next = await advance(current);
+        if (disposed) return;
+        if (next === current) timer = setTimeout(() => void poll(current), 3500);
+        else updateRun(next);
+      } catch (failure) {
+        if (!disposed) setError(String(failure));
+      }
+    }
+    void poll(run);
+    return () => {
+      disposed = true;
+      clearTimeout(timer);
+    };
+  }, [run, error]);
+
+  const choosePhotos = async () => {
+    try {
+      const chosen = await open({
+        multiple: true,
+        filters: [{ name: "Photos", extensions: ["jpg", "jpeg", "png", "webp"] }],
+      });
+      if (!chosen) return;
+      if (chosen.length > MAX_IMAGES) throw new Error("Select no more than 32 photos.");
+      setPhotos(chosen);
+      setError(undefined);
+    } catch (failure) {
+      setError(String(failure));
+    }
+  };
+
+  const start = async () => {
+    setBusy(true);
+    setError(undefined);
+    setSaved(undefined);
+    try {
+      const assets = await invoke<string[]>("atlas_upload", { images: photos });
+      updateRun({ stage: "submit", assets, requestId: crypto.randomUUID(), prompt });
+    } catch (failure) {
+      setError(String(failure));
+    } finally {
+      setBusy(false);
+    }
+  };
+
+  const download = async (asset: string) => {
+    setBusy(true);
+    setError(undefined);
+    try {
+      const path = await save({
+        defaultPath: "Atlas world.spz",
+        filters: [{ name: "Gaussian splat", extensions: ["spz"] }],
+      });
+      if (!path) return;
+      await invoke("atlas_download", { asset, path });
+      setSaved(path);
+    } catch (failure) {
+      setError(String(failure));
+    } finally {
+      setBusy(false);
+    }
+  };
+
+  return (
+    <section className="mx-auto max-w-3xl space-y-5 px-6 pb-8 pt-20">
+      <h2 className="text-xl font-semibold">World Labs Atlas</h2>
+      <p>Add 2–32 overlapping photos of the same scene to generate a draft Gaussian splat.</p>
+      <p className="text-sm opacity-80">Atlas bills the project API key configured for Studio.</p>
+      <div className="flex items-center gap-3">
+        <button type="button" className="rounded border px-3 py-2 disabled:opacity-50"
+          disabled={busy || Boolean(active)} onClick={() => void choosePhotos()}>Choose photos</button>
+        <span>{photos.length} selected</span>
+      </div>
+      <textarea aria-label="Scene description" className="w-full rounded border bg-ui-controls p-3"
+        placeholder="Optional scene description" rows={3} maxLength={2000}
+        disabled={busy || Boolean(active)} value={prompt}
+        onChange={(event) => setPrompt(event.target.value)} />
+      <div className="flex flex-wrap gap-3">
+        <button type="button" className="rounded bg-primary px-4 py-2 text-white disabled:opacity-50"
+          disabled={photos.length < 2 || busy || Boolean(active)}
+          onClick={() => void start()}>Generate draft world</button>
+        {run?.stage === "ready" && (
+          <button type="button" className="rounded border px-3 py-2"
+            disabled={busy} onClick={() => void download(run.asset)}>Save SPZ</button>
+        )}
+        {active && error && (
+          <>
+            <button type="button" className="rounded border px-3 py-2"
+              onClick={() => setError(undefined)}>Resume Atlas job</button>
+            <button type="button" className="rounded border px-3 py-2" onClick={() => {
+              localStorage.removeItem(STORAGE_KEY);
+              setRun(undefined);
+              setError(undefined);
+            }}>Clear from Studio</button>
+          </>
+        )}
+      </div>
+      {active && !error && (
+        <p role="status">{run.stage === "splat" ? "Reconstructing the splat…" : "Estimating cameras and depth…"}</p>
+      )}
+      {error && <p role="alert">{error}</p>}
+      {saved && <p role="status">Saved to {saved}</p>}
+    </section>
+  );
+}
